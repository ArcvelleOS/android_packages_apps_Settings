<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/miscellaneous_settings_title">

    <co.aospa.framework.preference.SystemSettingSwitchPreference
        android:key="allow_app_downgrade"
        android:title="@string/allow_app_downgrade_title"
        android:summary="@string/allow_app_downgrade_summary"
        android:defaultValue="false" />

    <co.aospa.framework.preference.SecureSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false" />

    <co.aospa.framework.preference.GlobalSettingSwitchPreference
        android:key="hide_screen_capture_status"
        android:title="@string/hide_screen_capture_status_title"
        android:summary="@string/hide_screen_capture_status_summary"
        android:defaultValue="false" />

    <co.aospa.framework.preference.SystemPropertySwitchPreference
        android:key="persist.sys.pairip.activity.block"
        android:title="@string/miscellaneous_pairip_activity_block_title"
        android:summary="@string/miscellaneous_pairip_activity_block_summary"
        android:defaultValue="false" />

</PreferenceScreen>
